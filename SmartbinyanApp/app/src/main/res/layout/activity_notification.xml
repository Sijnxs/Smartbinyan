<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".NotificationActivity">

    <!-- Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/eco"
        android:contentDescription="Background Image" />

    <!-- Soft overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3FFFFFF" />

    <!-- Main Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A5E34"
            android:padding="16dp"
            android:gravity="center"
            android:elevation="8dp"
            android:clipToOutline="true"
            android:translationZ="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SmartBinyan Notifications"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/noto_serif"
                android:letterSpacing="0.02"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="2" />
        </LinearLayout>

        <!-- Status Text -->
        <TextView
            android:id="@+id/tvNotificationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Bin online"
            android:textColor="#1A5E34"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="@font/noto_serif"
            android:gravity="center"
            android:padding="14dp"
            android:background="#F2FBF6"
            android:layout_marginVertical="12dp"
            android:layout_marginHorizontal="10dp"
            android:elevation="5dp"
            android:clipToOutline="true"
            android:translationZ="3dp"
            android:shadowColor="#145A32"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="1.5" />

        <!-- ✅ Added missing TextView to fix NullPointerException -->
        <TextView
            android:id="@+id/tvNoNotification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ No notifications yet"
            android:textColor="#808080"
            android:textSize="15sp"
            android:gravity="center"
            android:padding="10dp"
            android:layout_marginVertical="6dp"
            android:visibility="gone"
            android:background="#F8FFF9"
            android:fontFamily="@font/noto_serif" />

        <!-- Notifications List -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F8FFF9"
            android:padding="14dp"
            android:elevation="4dp"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="16dp"
            android:clipToOutline="true">

            <LinearLayout
                android:id="@+id/messageContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:showDividers="middle"
                android:dividerPadding="6dp"
                android:padding="10dp" />
        </ScrollView>

        <!-- Bottom Button (only Clear Notifications left) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="4dp">

            <!-- Clear Notifications Button -->
            <Button
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear Notifications"
                android:textColor="#1A5E34"
                android:textStyle="bold"
                android:fontFamily="@font/noto_serif"
                android:textSize="15sp"
                android:backgroundTint="#E0F7EA"
                android:paddingHorizontal="34dp"
                android:paddingVertical="12dp"
                android:elevation="8dp"
                android:translationZ="5dp"
                android:clipToOutline="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:tooltipText="Tap to clear notifications"
                android:outlineProvider="background"
                android:radius="45dp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
